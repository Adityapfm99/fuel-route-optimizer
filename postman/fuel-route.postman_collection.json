    {
      "name": "Coordinates: Seattle → Miami",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/route/?start=47.6062,-122.3321&finish=25.7617,-80.1918",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "47.6062,-122.3321"
            },
            {
              "key": "finish",
              "value": "25.7617,-80.1918"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test('gallons cover the distance at 10 mpg', () => pm.expect(d.total_gallons).to.be.closeTo(d.route.distance_miles / 10, 0.1));",
              "pm.test('stops are at most 500 miles apart', () => {",
              "  const m = [0, ...d.fuel_stops.map(s => s.route_mile), d.route.distance_miles];",
              "  for (let i = 2; i < m.length; i++) pm.expect(m[i] - m[i - 1]).to.be.at.most(500);",
              "});",
              "pm.test('at most one external API call', () => pm.expect(d.meta.external_api_calls).to.be.at.most(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "POST JSON: Denver, CO → Dallas, TX",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Denver, CO\",\n  \"finish\": \"Dallas, TX\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/route/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ]
        }
      }
    },
    {
